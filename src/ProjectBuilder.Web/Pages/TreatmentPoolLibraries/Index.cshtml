            <button class="btn-guide" id="btnGuide"><span class="q">?</span> Guide</button>
            @if (canCreate)
            {
            <button class="btn-new" id="createnewlibrarybtn">Create New Treatment Pool Library</button>
            }
        </div>
    </div>

    <div id="jobStatusBanner" role="alert">
        <span class="run-status-spinner" id="jobStatusSpinner"></span>
        <span id="jobStatusMessage"></span>
