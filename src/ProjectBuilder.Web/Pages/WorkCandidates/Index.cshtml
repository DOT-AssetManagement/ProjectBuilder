@page
@model ProjectBuilder.Web.Pages.WorkCandidates.IndexModel
@using Volo.Abp.Authorization.Permissions
@using ProjectBuilder.Permissions
@inject IPermissionChecker PermissionChecker
@{
    ViewData["Title"] = "Work Candidates";
    ViewData["PBVariant"] = "app";
    ViewData["PBActivePage"] = "supplementalcandidates";
    Layout = "~/Pages/Shared/PBDSSLayout.cshtml";

    var canCreate = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Create);
    var canEdit = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Edit);
    var canDelete = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Delete);
    var canImportWork = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.ImportWorkCandidates);
    var canWorkCandidates = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Default);
    var canConfiguration = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Default);
    var canRun = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Run);

    var candidatesNav = new ProjectBuilder.Web.Pages.Shared.PoolCandidatesNavViewModel
    {
        PoolId = Guid.Parse(Model.PoolId),
        PoolName = Model.PoolName,
        ActiveMenu = "WorkCandidates",
        CanWorkCandidates = canWorkCandidates,
        CanConfiguration = canConfiguration,
        CanRun = canRun
    };

    string Fmt2(double? v) => v.HasValue ? v.Value.ToString("N2") : "";
    string FmtMoney(float? v) => v.HasValue ? v.Value.ToString("N0") : "";
    string FmtDate(DateTime? dt) => dt.HasValue ? dt.Value.ToString("MM/dd/yyyy") : "";

    var rows = (Model.WorkCandidates ?? new List<ProjectBuilder.Models.WorkCandidates.Dtos.WorkCandidatesDto>())
        .Select(w => new
        {
            id              = w.Id,
            poolId          = w.UserLibraryId,
            projectName     = w.ProjectName,
            assetType       = w.AssetType,
            district        = w.District,
            county          = w.Cnty,
            route           = w.Route,
            fromSection     = w.FromSection,
            toSection       = w.ToSection,
            description     = w.Description,
            cost            = w.Cost,
            totalScore      = Fmt2(w.TotalScore),
            safetyScore     = Fmt2(w.SafetyScore),
            mobilityScore   = Fmt2(w.MobilityAndEconomyScore),
            equityScore     = Fmt2(w.EquityAndAccessScore),
            resilienceScore = Fmt2(w.ResilienceAndEnvironmentScore),
            conditionScore  = Fmt2(w.ConditionAndPerformanceScore),
            treatment       = w.Treatment,
            createdBy       = w.CreatedBy,
            createdAt       = FmtDate(w.CreatedAt)
        })
        .ToList();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pbdss/scenarioedit.css" />
    <style>
        body { overflow: hidden; }
        main { display: flex; flex-direction: row; margin-top: 0; padding: 0; width: 100%; overflow: hidden; background-color: rgb(248,248,248); height: calc(100vh - 70px - 44px); }
        .wc-content  { flex: 1; min-width: 0; padding: 20px 24px; overflow: hidden; height: 100%; display: flex; flex-direction: column; }
        #table-wc    { flex: 1; min-height: 0; }
    </style>
}

<partial name="_PoolCandidatesNav" model="candidatesNav" />

<div class="wc-content">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" style="white-space:pre-line;" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="search-bar">
        <label>Filter Work Candidates</label>
        <select id="filterDistrict" class="form-select form-select-sm" style="width:140px"></select>
        <select id="filterCounty"   class="form-select form-select-sm" style="width:140px" disabled></select>
        <select id="filterRoute"    class="form-select form-select-sm" style="width:140px" disabled></select>
        <select id="filterSection"  class="form-select form-select-sm" style="width:140px" disabled></select>
        <button class="btn-reset btn-sm" id="btnReset">Reset</button>
        @if (canImportWork)
        {
        <button type="button" class="btn-new ms-auto" id="btnImport">
            <i class="fa-solid fa-file-import me-1"></i> Import
        </button>
        <a class="btn-new" style="margin-left:8px;" href="/templates/WorkCandidates_Template.xlsx" download="WorkCandidates_Template.xlsx">Download Template</a>
        }
        @if (canCreate)
        {
        <a href="/WorkCandidates/Create?id=@Model.PoolId" class="btn btn-primary btn-sm @(canImportWork ? "" : "ms-auto")">
            Add Work Candidate
        </a>
        }
        @if (canWorkCandidates)
        {
        <a href="?handler=Export&poolId=@Model.PoolId" class="btn-new @(canCreate || canImportWork ? "" : "ms-auto")">
            Export
        </a>
        }
    </div>

    <div class="table-wrap">
        <div id="table-wc"></div>
    </div>

</div>

@* ── Import Work Candidates ── *@
<div class="modal fade" id="importModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Work Candidates</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="importForm" class="needs-validation" method="post" enctype="multipart/form-data" novalidate
                  asp-page-handler="ImportWorkCandidates">
                <div class="modal-body">
                    <input type="hidden" name="PoolId" value="@Model.PoolId" />
                    <div class="mb-3">
                        <label class="form-label d-block">Import Mode</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="importModeDeleteAll" name="deleteAll" value="true" checked />
                            <label class="form-check-label" for="importModeDeleteAll">Delete All</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="importModeKeepAll" name="deleteAll" value="false" />
                            <label class="form-check-label" for="importModeKeepAll">Keep All</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Excel File</label>
                        <input class="form-control" type="file" id="importFile" name="excelfile" required accept=".xlsx,.xls" />
                        <div id="fileValidation" class="invalid-feedback">File is required</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tab Name</label>
                        <input class="form-control" type="text" name="tabname" value="WorkCandidates" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Work Candidate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill text-danger fa-2x me-3"></i>
                <span>Are you sure you want to delete this work candidate?</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<form id="antiforgery-form" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="~/js/pbdss/table.js"></script>
    <script>
        var tableData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows));
        var poolId    = '@Model.PoolId';

        function antiToken() { return $('input[name="__RequestVerificationToken"]').first().val(); }

        function formatRoute(v) {
            if (v === null || v === undefined || v === '') return '';
            return String(v).padStart(4, '0');
        }

        function fmtMoney(cell) {
            var v = parseFloat(cell.getValue());
            return isNaN(v) ? '' : v.toLocaleString('en-US', { maximumFractionDigits: 0 });
        }

        function routeFmt(cell) { return formatRoute(cell.getValue()); }

        function projectNameFmt(cell) {
            var val = cell.getValue();
            var el = document.createElement('span');
            el.className = 'text-truncate d-inline-block';
            el.style.maxWidth = '100%';
            el.textContent = val ?? '';
            el.title = val ?? '';
            return el;
        }

        function sectionFmt(cell) {
            var d = cell.getData();
            var from = d.fromSection, to = d.toSection;
            if ((from === null || from === undefined || from === '') && (to === null || to === undefined || to === '')) return '';
            return (from ?? '') + '-' + (to ?? '');
        }

        function projectNameSorter(a, b) {
            var numA = parseInt(String(a).replace(/[^0-9]/g, ''), 10);
            var numB = parseInt(String(b).replace(/[^0-9]/g, ''), 10);
            numA = isNaN(numA) ? 0 : numA;
            numB = isNaN(numB) ? 0 : numB;
            return numA - numB;
        }

        var currentDeleteId = null;

        var actions = [
            @if (canEdit) { <text>{ label: 'Edit', icon: 'fa-solid fa-pencil', onClick: function (d) { window.location.href = '/WorkCandidates/Create?id=' + poolId + '&candidateId=' + d.id; } },</text> }
            @if (canCreate) { <text>{ label: 'Copy', icon: 'fa-solid fa-copy', onClick: function (d) { window.location.href = '/WorkCandidates/Create?id=' + poolId + '&copyFrom=' + d.id; } },</text> }
            @if (canDelete) { <text>{ label: 'Delete', icon: 'fa-solid fa-trash', type: 'delete', onClick: function (d) {
                currentDeleteId = d.id;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal')).show();
            }}</text> }
        ];

        var table = createTable('#table-wc', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            actions: actions,
            columns: [
                { title: 'Project Name',       field: 'projectName',      width: 180,    headerSort: false, sorter: projectNameSorter, formatter: projectNameFmt },
                { title: 'Asset Type',         field: 'assetType',        width: 100,    headerSort: false },
                { title: 'District',           field: 'district',         width: 85,     hozAlign: 'right', headerSort: false },
                { title: 'County',             field: 'county',           width: 85,     hozAlign: 'right', headerSort: false },
                { title: 'Route',              field: 'route',            width: 80,     hozAlign: 'right', headerSort: false, formatter: routeFmt },
                { title: 'Section',            field: 'fromSection',      width: 110,    hozAlign: 'right', headerSort: false, formatter: sectionFmt },
                { title: 'Description',        field: 'description',      minWidth: 180, headerSort: false },
                { title: 'Cost',               field: 'cost',             width: 110,    hozAlign: 'right', headerSort: false, formatter: fmtMoney },
                { title: 'Total Score',        field: 'totalScore',       width: 110,    hozAlign: 'right', headerSort: false },
                { title: 'Safety',             field: 'safetyScore',      width: 90,     hozAlign: 'right', headerSort: false },
                { title: 'Mobility',           field: 'mobilityScore',    width: 90,     hozAlign: 'right', headerSort: false },
                { title: 'Equity',             field: 'equityScore',      width: 90,     hozAlign: 'right', headerSort: false },
                { title: 'Resilience',         field: 'resilienceScore',  width: 100,    hozAlign: 'right', headerSort: false },
                { title: 'Condition',          field: 'conditionScore',   width: 100,    hozAlign: 'right', headerSort: false },
                { title: 'Treatment',          field: 'treatment',        minWidth: 130, headerSort: false },
                { title: 'Created By',         field: 'createdBy',        minWidth: 130, headerSort: false },
                { title: 'Created',            field: 'createdAt',        width: 105,    headerSort: false }
            ]
        });

        // ── Cascading filters (client-side): District -> County -> Route -> Section ──
        var filterDistrict = document.getElementById('filterDistrict');
        var filterCounty   = document.getElementById('filterCounty');
        var filterRoute    = document.getElementById('filterRoute');
        var filterSection  = document.getElementById('filterSection');

        function uniqueSorted(values) {
            var seen = new Set();
            values.forEach(function (v) { if (v !== null && v !== undefined && v !== '') seen.add(String(v)); });
            return Array.from(seen).sort(function (a, b) { return a.localeCompare(b, undefined, { numeric: true }); });
        }

        function fillSelect(sel, values, placeholder, disabled, formatText) {
            sel.innerHTML = '<option value="">' + placeholder + '</option>' +
                values.map(function (v) {
                    var text = formatText ? formatText(v) : v;
                    return '<option value="' + v + '">' + text + '</option>';
                }).join('');
            sel.value = '';
            sel.disabled = !!disabled;
        }

        function rowsMatching(upToField) {
            return tableData.filter(function (r) {
                if (filterDistrict.value && String(r.district) !== filterDistrict.value) return false;
                if (upToField === 'district') return true;
                if (filterCounty.value && String(r.county) !== filterCounty.value) return false;
                if (upToField === 'county') return true;
                if (filterRoute.value && String(r.route) !== filterRoute.value) return false;
                return true;
            });
        }

        function refreshCounty()  { fillSelect(filterCounty,  uniqueSorted(rowsMatching('district').map(function (r) { return r.county; })),      'County',  !filterDistrict.value); }
        function refreshRoute()   { fillSelect(filterRoute,   uniqueSorted(rowsMatching('county').map(function (r) { return r.route; })),         'Route',   !filterCounty.value, formatRoute); }
        function refreshSection() { fillSelect(filterSection, uniqueSorted(rowsMatching('route').map(function (r) { return r.fromSection; })),     'Section', !filterRoute.value); }

        function applyFilters() {
            var d = filterDistrict.value, c = filterCounty.value, r = filterRoute.value, s = filterSection.value;
            if (!d && !c && !r && !s) {
                table.clearFilter();
            } else {
                table.setFilter(function (data) {
                    return (!d || String(data.district)    === d)
                        && (!c || String(data.county)      === c)
                        && (!r || String(data.route)       === r)
                        && (!s || String(data.fromSection) === s);
                });
            }
            table.pbSaveFilters({ district: d, county: c, route: r, section: s });
        }

        fillSelect(filterDistrict, uniqueSorted(tableData.map(function (r) { return r.district; })), 'District', false);
        fillSelect(filterCounty, [], 'County', true);
        fillSelect(filterRoute, [], 'Route', true);
        fillSelect(filterSection, [], 'Section', true);

        // Restore filters saved before navigating away (or before an edit/delete-triggered
        // reload) so the grid comes back exactly as the user left it.
        (function restoreFilterState() {
            var saved = table.pbSavedFilters;
            if (!saved) return;

            filterDistrict.value = saved.district || '';
            refreshCounty();

            filterCounty.value = saved.county || '';
            refreshRoute();

            filterRoute.value = saved.route || '';
            refreshSection();

            filterSection.value = saved.section || '';

            applyFilters();
        })();

        filterDistrict.addEventListener('change', function () {
            refreshCounty();
            fillSelect(filterRoute, [], 'Route', true);
            fillSelect(filterSection, [], 'Section', true);
            applyFilters();
        });
        filterCounty.addEventListener('change', function () {
            refreshRoute();
            fillSelect(filterSection, [], 'Section', true);
            applyFilters();
        });
        filterRoute.addEventListener('change', function () {
            refreshSection();
            applyFilters();
        });
        filterSection.addEventListener('change', applyFilters);

        document.getElementById('btnReset').addEventListener('click', function () {
            fillSelect(filterDistrict, uniqueSorted(tableData.map(function (r) { return r.district; })), 'District', false);
            fillSelect(filterCounty, [], 'County', true);
            fillSelect(filterRoute, [], 'Route', true);
            fillSelect(filterSection, [], 'Section', true);
            table.clearFilter();
            table.pbSaveFilters({ district: '', county: '', route: '', section: '' });
        });

        // ── Delete confirm ──
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!currentDeleteId) return;
            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            $.ajax({
                type: 'GET', url: '?handler=Delete&id=' + currentDeleteId + '&PoolId=' + poolId,
                headers: { 'RequestVerificationToken': antiToken() },
                success: function () { location.reload(); },
                error: function (xhr) { alert(xhr.responseText || 'Unable to delete.'); }
            });
        });

        // ── Import ──
        var btnImport = document.getElementById('btnImport');
        if (btnImport) {
            btnImport.addEventListener('click', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('importModal')).show();
            });
        }

        $('#importForm').on('submit', function (e) {
            var file = $('#importFile')[0].files[0];
            if (!file) {
                $('#fileValidation').addClass('d-block');
                $('#importFile').addClass('is-invalid');
                e.preventDefault();
            }
        });

        $('#importFile').on('change', function () {
            $('#fileValidation').removeClass('d-block');
            $('#importFile').removeClass('is-invalid');
        });

        $('#importModal').on('hidden.bs.modal', function () {
            $('#importForm').trigger('reset');
            $('#fileValidation').removeClass('d-block');
            $('#importFile').removeClass('is-invalid');
        });

        // ── Auto-open import if deep-linked (?import=true) ──
        $(document).ready(function () {
            if ('@Model.Import'.toLowerCase() === 'true') {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('importModal')).show();
            }
        });
    </script>
    <partial name="_PoolCandidatesRunScript" />
}
