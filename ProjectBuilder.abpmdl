    },
    "ProjectBuilder.EntityFrameworkCore.Tests": {
      "path": "test/ProjectBuilder.EntityFrameworkCore.Tests/ProjectBuilder.EntityFrameworkCore.Tests.abppkg",
      "folder": "test"
    },
    "ProjectBuilder.EntityFrameworkCore": {
