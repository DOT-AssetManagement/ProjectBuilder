@page
@model ProjectBuilder.Web.Pages.Import.MAS.IndexModel
@{
    ViewData["Title"] = "Import MAS";
    Layout = "Shared/AdminLayout";
    ViewData["SubMenu"] = "ImportMAS";
}

<div class="editscen-content__header"><h1>Import MAS</h1></div>

<div class="mx-3 mt-3" style="max-width:520px">

    <div id="masImportStatusBanner" class="job-status-banner" role="alert">
        <span class="run-status-spinner"></span>
        <span class="job-status-message"></span>
        <button type="button" class="run-status-close" title="Dismiss">&times;</button>
    </div>

    <p class="text-muted">Upload an Excel file to import Maintainable Asset Segmentation (MAS) data into the system.</p>

    <form id="masImportForm" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label fw-semibold">Excel File <span class="text-danger">*</span></label>
            <input type="file" class="form-control" name="excelfile" accept=".xlsx,.xls" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Tab Name</label>
            <input type="text" class="form-control" name="tabname" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-file-import me-1"></i> Import
            </button>
            <button type="reset" class="btn btn-secondary">Cancel</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/import-job.js"></script>
    <script>
        initBackgroundImportForm({
            formId: 'masImportForm',
            bannerId: 'masImportStatusBanner',
            storageKey: 'importMasJobId',
            runningMessage: 'MAS import running in the background…',
            successMessage: 'MAS data imported successfully.'
        });
    </script>
}
