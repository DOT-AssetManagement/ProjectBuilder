@page
@using System.Linq
@model ProjectBuilder.Web.Pages.SetUp.Measures.ListModel
@{
    ViewData["Title"] = "Measures";
    Layout = "Shared/AdminLayout";
    ViewData["SubMenu"] = "Measures";

    var rows = Model.Measures.Select(m => new {
        id          = m.Id,
        name        = m.Name,
        description = m.Description,
        status      = m.Status
    }).ToList();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
}

<div class="editscen-content__header"><h1>Measures</h1></div>

<div class="search-bar">
    <label>Search in Measures</label>
    <div class="search-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="" />
    </div>
    <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
    <button class="btn-reset btn-sm" id="btnReset">Reset</button>
</div>

<div class="table-wrap">
    <div id="admin-table"></div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Edit Measure</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" name="id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" class="form-control" id="editName" name="name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <input type="text" class="form-control" id="editDescription" name="description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <input type="number" class="form-control" id="editStatus" name="status" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete form -->
<form id="deleteForm" method="post" asp-page-handler="Delete" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="~/js/pbdss/table.js"></script>
    <script>
        var tableData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows));

        var table = createTable('#admin-table', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            actions: [
                {
                    label: 'Edit', icon: 'fa-solid fa-pen',
                    onClick: function (d) {
                        document.getElementById('editId').value = d.id;
                        document.getElementById('editName').value = d.name || '';
                        document.getElementById('editDescription').value = d.description || '';
                        document.getElementById('editStatus').value = d.status !== null ? d.status : '';
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
                    }
                },
                {
                    label: 'Delete', icon: 'fa-solid fa-trash', type: 'delete',
                    onClick: function (d) {
                        if (confirm('Delete measure "' + d.name + '"?')) {
                            document.getElementById('deleteId').value = d.id;
                            document.getElementById('deleteForm').submit();
                        }
                    }
                }
            ],
            columns: [
                { title: 'Name',        field: 'name',        minWidth: 180, headerSort: false },
                { title: 'Description', field: 'description', minWidth: 240, headerSort: false },
                { title: 'Status',      field: 'status',       width: 100, hozAlign: 'right', headerSort: false }
            ]
        });

        function applySearchFilter() {
            var v = document.getElementById('searchInput').value.trim().toLowerCase();
            table.clearFilter();
            if (v) table.setFilter(function (d) { return Object.values(d).some(function (x) { return String(x).toLowerCase().includes(v); }); });
            table.pbSaveFilters({ search: v });
        }
        document.getElementById('btnSearch').addEventListener('click', applySearchFilter);
        document.getElementById('searchInput').addEventListener('keypress', function (e) { if (e.key === 'Enter') document.getElementById('btnSearch').click(); });
        document.getElementById('btnReset').addEventListener('click', function () {
            document.getElementById('searchInput').value = '';
            table.clearFilter();
            table.pbSaveFilters({ search: '' });
        });

        // Restore a filter saved before navigating away, or before an edit/delete post-back.
        (function restoreSearchFilter() {
            var saved = table.pbSavedFilters;
            if (saved && saved.search) {
                document.getElementById('searchInput').value = saved.search;
                applySearchFilter();
            }
        })();
    </script>
}
