      "folder": "src"
    },
    "ProjectBuilder.Application.Contracts": {
      "path": "src/ProjectBuilder.Application.Contracts/ProjectBuilder.Application.Contracts.abppkg",
      "folder": "src"
    },
    "ProjectBuilder.HttpApi": {
      "path": "src/ProjectBuilder.HttpApi/ProjectBuilder.HttpApi.abppkg",
      "folder": "src"
    },
    "ProjectBuilder.HttpApi.Client": {
      "path": "src/ProjectBuilder.HttpApi.Client/ProjectBuilder.HttpApi.Client.abppkg",
      "folder": "src"
    },
    "ProjectBuilder.Web": {
      "path": "src/ProjectBuilder.Web/ProjectBuilder.Web.abppkg",
      "folder": "src"
    },
    "ProjectBuilder.Web.Tests": {
      "path": "test/ProjectBuilder.Web.Tests/ProjectBuilder.Web.Tests.abppkg",
