@inject Volo.Abp.Users.ICurrentUser CurrentUser
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Security.Claims
@{
    // Layout configuration via ViewData:
    //   PBVariant    : "app" (default) | "public"
    //   PBActivePage : key of the active nav link  (scenarios | treatmentpoollibraries | supplementalcandidates)
    //   PBShowNav    : "false" to hide the nav links (app variant only) for a clean landing look
    //   Title        : page <title>
    // Optional sections a page may define:
    //   Styles   : extra <link>/<style> in <head>
    //   Scripts  : extra <script> before </body>
    //   navRight : custom markup for the right side of the navbar (overrides the default)
    var pbVariant    = ViewData["PBVariant"]?.ToString() ?? "app";
    var pbActivePage = ViewData["PBActivePage"]?.ToString() ?? "";
    var pbShowNav    = !string.Equals(ViewData["PBShowNav"]?.ToString(), "false", StringComparison.OrdinalIgnoreCase);
    var displayUserName = User.Identity?.Name
        ?? CurrentUser.Name
        ?? CurrentUser.UserName
        ?? CurrentUser.Email
        ?? User.FindFirstValue(ClaimTypes.Email)
        ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Project Builder")</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/pbdss/layout.css" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <nav id="main-navbar">
        <div class="navbar_maincontainer">
            <div class="logos-container">
                <img src="~/images/pbdss/logo.png" alt="PennDOT" style="height:70px;object-fit:contain" />
                <div class="verticalline"></div>
                <a href="/Dashboard" class="navbar-projectbuilder-link" title="Dashboard" aria-label="Go to Dashboard">
                    <img src="~/images/pbdss/SecondaryLogo.svg" alt="Project Builder" style="height:70px;object-fit:contain" />
                </a>
            </div>

            @if (pbVariant == "app")
            {
                @if (pbShowNav)
                {
                    <div class="navbar_navigation-container">
                        @await Html.PartialAsync("Shared/_PermissionNav")
                    </div>
                }

                @if (IsSectionDefined("navRight"))
                {
                    @await RenderSectionAsync("navRight", required: false)
                }
                else
                {
                    <div class="navbar_userinfo-container">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                        @if (!string.IsNullOrWhiteSpace(displayUserName))
                        {
                            <p class="navbar-username" title="@displayUserName">@displayUserName</p>
                        }
                        <div class="verticalline"></div>
                        <a href="/Account/Logout" class="circle" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
                    </div>
                }
            }
            else
            {
                @if (IsSectionDefined("navRight"))
                {
                    @await RenderSectionAsync("navRight", required: false)
                }
                else
                {
                    <div class="navbar_userinfo-container">
                        <button class="btn-signin-nav" onclick="location.href='/Account/Login'">Sign in</button>
                    </div>
                }
            }
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="app-footer"><div class="app-footer__content">ProjectBuilder &copy; 2026 v@(Configuration["App:Version"]) &mdash; ALL RIGHTS RESERVED</div></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
