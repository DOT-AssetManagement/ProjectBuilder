@page
@using System.Linq
@model ProjectBuilder.Web.Pages.SetUp.TreatmentCancellationMatrix.IndexModel
@{
    ViewData["Title"] = "Treatment Cancellation Matrix";
    Layout = "Shared/AdminLayout";
    ViewData["SubMenu"] = "TreatmentCancellationMatrix";

    var rows = Model.MatrixItems.Select(t => new {
        id         = t.Id,
        assetTypeA = t.AssetTypeA.ToString(),
        assetTypeB = t.AssetTypeB.ToString(),
        treatmentB = t.TreatmentB
    }).ToList();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
}

<div class="editscen-content__header"><h1>Treatment Cancellation Matrix</h1></div>

<div class="search-bar">
    <label>Search in Cancellation Matrix</label>
    <div class="search-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="" />
    </div>
    <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
    <button class="btn-reset btn-sm" id="btnReset">Reset</button>
</div>

<div class="table-wrap">
    <div id="admin-table"></div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Edit Cancellation Matrix Entry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" name="id" />
                    <input type="hidden" id="editAssetTypeA" name="assetTypeA" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Asset Type A</label>
                        <input type="text" class="form-control" id="editAssetTypeADisplay" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Asset Type B</label>
                        <input type="text" class="form-control" id="editAssetTypeB" name="assetTypeB" maxlength="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Treatment B</label>
                        <input type="text" class="form-control" id="editTreatmentB" name="treatmentB" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete form -->
<form id="deleteForm" method="post" asp-page-handler="Delete" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteAssetTypeA" name="assetTypeA" />
    <input type="hidden" id="deleteTreatmentB" name="treatmentB" />
</form>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="~/js/pbdss/table.js"></script>
    <script>
        var tableData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows));

        var table = createTable('#admin-table', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            actions: [
                {
                    label: 'Edit', icon: 'fa-solid fa-pen',
                    onClick: function (d) {
                        document.getElementById('editId').value = d.id;
                        document.getElementById('editAssetTypeA').value = d.assetTypeA;
                        document.getElementById('editAssetTypeADisplay').value = d.assetTypeA;
                        document.getElementById('editAssetTypeB').value = d.assetTypeB;
                        document.getElementById('editTreatmentB').value = d.treatmentB || '';
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
                    }
                },
                {
                    label: 'Delete', icon: 'fa-solid fa-trash', type: 'delete',
                    onClick: function (d) {
                        if (confirm('Delete entry for "' + d.assetTypeA + ' / ' + d.treatmentB + '"?')) {
                            document.getElementById('deleteAssetTypeA').value = d.assetTypeA;
                            document.getElementById('deleteTreatmentB').value = d.treatmentB;
                            document.getElementById('deleteForm').submit();
                        }
                    }
                }
            ],
            columns: [
                { title: 'Asset Type A', field: 'assetTypeA', width: 130, headerSort: false },
                { title: 'Asset Type B', field: 'assetTypeB', width: 130, headerSort: false },
                { title: 'Treatment B',  field: 'treatmentB', minWidth: 200, headerSort: false }
            ]
        });

        function applySearchFilter() {
            var v = document.getElementById('searchInput').value.trim().toLowerCase();
            table.clearFilter();
            if (v) table.setFilter(function (d) { return Object.values(d).some(function (x) { return String(x).toLowerCase().includes(v); }); });
            table.pbSaveFilters({ search: v });
        }
        document.getElementById('btnSearch').addEventListener('click', applySearchFilter);
        document.getElementById('searchInput').addEventListener('keypress', function (e) { if (e.key === 'Enter') document.getElementById('btnSearch').click(); });
        document.getElementById('btnReset').addEventListener('click', function () {
            document.getElementById('searchInput').value = '';
            table.clearFilter();
            table.pbSaveFilters({ search: '' });
        });

        // Restore a filter saved before navigating away, or before an edit/delete post-back.
        (function restoreSearchFilter() {
            var saved = table.pbSavedFilters;
            if (saved && saved.search) {
                document.getElementById('searchInput').value = saved.search;
                applySearchFilter();
            }
        })();
    </script>
}
