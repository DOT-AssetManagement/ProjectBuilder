                        <select class="form-select" name="importtype">
                            <option value="B" selected>BAMS</option>
                            <option value="P">PAMS</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label><input type="radio" name="option" value="deleteAll" checked onchange="updateFromScratch()"> Delete All
                            <input type="checkbox" id="fromScratch" name="fromScratch" checked value="true" hidden /></label>&nbsp;&nbsp;
                        <label><input type="radio" name="option" value="keepUserCreated" onchange="updateFromScratch()"> Keep User Created</label>&nbsp;&nbsp;
                        <label><input type="radio" name="option" value="keepAll" onchange="updateFromScratch()"> Keep All
                            <input type="checkbox" id="keepAll" name="keepAll" value="false" hidden /></label>
                    </div>
                    <div class="mb-3">
