    </div>

</div>

<!-- Create Library Modal -->
<div class="modal fade" id="CreateNewLibraryForm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Treatment Pool Library</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createlibraryModal" method="post" asp-page-handler="CreateLibrary" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Treatment Pool Library Name</label>
                        <input type="text" name="Name" id="createlibraryname" maxlength="50" class="form-control" required
                               oninput="validateLibraryName(this, 'namefeedback', '')" />
                        <div id="namefeedback" class="invalid-feedback">Field is required</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Treatment Pool Library Description</label>
                        <input type="text" name="Description" id="createlibrarydescription" class="form-control" required
                               oninput="validateLibraryDescription(this, 'descriptionfeedback')" />
                        <div id="descriptionfeedback" class="invalid-feedback">Field is required</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isshared" id="isshared_create" value="true">
                            <label class="form-check-label" for="isshared_create">Shared</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Library Modal -->
<div class="modal fade" id="EditLibraryForm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Treatment Pool Library</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editlibrary" method="post" asp-page-handler="EditLibrary" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="libraryId" id="editlibraryId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Treatment Pool Library Name</label>
                        <input type="text" name="libraryname" id="editlibraryname" maxlength="50" class="form-control" required
                               oninput="validateLibraryName(this, 'editnamefeedback', document.getElementById('editlibraryId').value)" />
                        <div id="editnamefeedback" class="invalid-feedback">Field is required</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Treatment Pool Library Description</label>
                        <input type="text" name="librarydescription" id="editlibrarydescription" class="form-control" required
                               oninput="validateLibraryDescription(this, 'editdescriptionfeedback')" />
                        <div id="editdescriptionfeedback" class="invalid-feedback">Field is required</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isshared" id="editisshared" value="true">
                            <label class="form-check-label" for="editisshared">Is Shared</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Copy Library Modal -->
<div class="modal fade" id="CopyLibraryForm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Copy Treatment Pool Library</h5>
