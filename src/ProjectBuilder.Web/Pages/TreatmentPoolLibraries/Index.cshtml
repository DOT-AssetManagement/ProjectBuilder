<form id="antiforgery-form" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="~/js/pbdss/table.js"></script>
    <script src="~/js/pbdss/tabname-autofill.js"></script>
    <script>
        var tableData     = @Html.Raw(JsonSerializer.Serialize(libraryRows));
        var currentUserId = @Html.Raw(JsonSerializer.Serialize(Model.CurrentUserId));

        function showOverlay() { document.getElementById('overlay').style.display = 'flex'; }
        function hideOverlay() { document.getElementById('overlay').style.display = 'none'; }
        function go(url) { showOverlay(); setTimeout(function () { window.location.href = url; }, 600); }
        function antiToken() { return $('input[name="__RequestVerificationToken"]').first().val(); }

        // ── Action handlers ──

        function openEdit(d) {
            $.ajax({
                type: 'POST',
                url: '?handler=GetLibrary',
                data: JSON.stringify(d.poolId),
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': antiToken() },
                success: function (r) {
                    document.getElementById('editlibraryId').value    = r.id          ?? r.Id          ?? '';
                    document.getElementById('editlibraryname').value  = r.name        ?? r.Name        ?? '';
                    document.getElementById('editlibrarydescription').value = r.description ?? r.Description ?? '';
                    document.getElementById('editisshared').checked   = !!(r.isShared ?? r.IsShared);
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('EditLibraryForm')).show();
                },
                error: function () { alert('Unable to load library. Please try again.'); }
            });
        }

        var _importLibraryName = '';

        function openImport(d) {
            _importLibraryName = d.name || '';
            document.getElementById('candidatepool_name').value = d.name;
            document.getElementById('candidatepoolid').value = d.poolId;
            document.getElementById('treatmentimportform').classList.remove('was-validated');
            // Defensively re-enable: this is the actual retry entry point, so every
            // fresh open should be ready to submit regardless of how the previous
            // attempt ended.
            var importSubmitBtn = document.querySelector('#treatmentimportform [type=submit]');
            if (importSubmitBtn) importSubmitBtn.disabled = false;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('importtreatment')).show();
        }

        function openDelete(d) {
            document.getElementById('deletelibraryId').value = d.poolId;
            if (d.isDeleteable) {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('deletealertfalse')).show();
            } else {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('deletealerttrue')).show();
            }
        }

        function openCopy(d) {
            document.getElementById('copylibraryId').value = d.poolId;
            document.getElementById('copylibraryname').value = '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('CopyLibraryForm')).show();
        }

        // ── Table ──

        var actions = [
            @if (canEdit) { <text>{ label: 'Edit', icon: 'fa-regular fa-pen-to-square', disabled: function (d) { return !d.canEdit; }, onClick: function (d) { openEdit(d); } },</text> }
            @if (canImport) { <text>{ label: 'Import', icon: 'fa-solid fa-file-import', disabled: function (d) { return !d.canEdit; }, onClick: function (d) { openImport(d); } },</text> }
            @if (canDelete) { <text>{ label: 'Delete', icon: 'fa-regular fa-trash-can', type: 'delete', disabled: function (d) { return !d.canEdit; }, onClick: function (d) { openDelete(d); } },</text> }
            @if (canCopy) { <text>{ label: 'Copy', icon: 'fa-regular fa-copy', onClick: function (d) { openCopy(d); } },</text> }
            @if (canTreatments) { <text>{ label: 'Treatments', icon: 'fa-solid fa-flask', onClick: function (d) { go('/Treatments/Index/' + d.poolId); } }</text> }
        ];

        var table = createTable('#table-tpl', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            actions: actions,
            columns: [
                { title: 'Name',                 field: 'name',                    minWidth: 200, headerSort: false },
                { title: 'Description',          field: 'descriptionShort',        minWidth: 180, headerSort: false },
                { title: 'Scenario',             field: 'scenarioName',            minWidth: 160, headerSort: false },
                { title: 'Number of Treatments', field: 'treatmentsCount',         minWidth: 180, hozAlign: 'right', headerSort: false },
                { title: 'Pavement Count',       field: 'pavementTreatmentsCount', minWidth: 145, hozAlign: 'right', headerSort: false },
                { title: 'Bridge Count',         field: 'bridgeTreatmentsCount',   minWidth: 130, hozAlign: 'right', headerSort: false },
                { title: 'Is Imported',          field: 'isImported',              minWidth: 120, headerSort: false },
                { title: 'Shared',               field: 'shared',                  minWidth: 100, headerSort: false },
                { title: 'Owner',                field: 'ownerDisplay',            minWidth: 160, headerSort: false },
                { title: 'Import Date',          field: 'importDate',              minWidth: 150, headerSort: false },
                { title: 'Date Created',         field: 'createdAt',               minWidth: 150, headerSort: false },
                { title: 'Source',               field: 'source',                  minWidth: 110, headerSort: false }
            ]
        });

        // ── Name / description validation ──
        function validateLibraryDescription(input, feedbackId) {
            var feedback = document.getElementById(feedbackId);
            if (!input.value.trim()) {
                input.classList.add('is-invalid');
                if (feedback) feedback.innerText = 'Field is required';
                return false;
            }
            input.classList.remove('is-invalid');
            if (feedback) feedback.innerText = '';
            return true;
        }

        function validateCopyLibraryName() {
            var input = document.getElementById('copylibraryname');
            var feedback = document.getElementById('CopynNamefeedback');
            var name = input.value.trim();
            if (!name) {
                input.classList.add('is-invalid');
                feedback.innerText = 'Field is required';
                return false;
            }
            if (!/[a-zA-Z0-9]/.test(name)) {
                input.classList.add('is-invalid');
                feedback.innerText = 'Name must contain at least one letter or number';
                return false;
            }
            validateLibraryName(input, 'CopynNamefeedback', '');
            return !input.classList.contains('is-invalid') || feedback.innerText !== 'Name already exists';
        }

        var _nameCheckSeq = {};

        function validateLibraryName(input, feedbackId, libraryid) {
            var name     = input.value.trim();
            var feedback = document.getElementById(feedbackId);
            if (!name) {
                input.classList.add('is-invalid');
                feedback.innerText = 'Field is required';
                return;
            }
            if (!/[a-zA-Z0-9]/.test(name)) {
                input.classList.add('is-invalid');
                feedback.innerText = 'Name must contain at least one letter or number';
                return;
            }
            var seq = (_nameCheckSeq[feedbackId] = (_nameCheckSeq[feedbackId] || 0) + 1);
            $.ajax({
                type: 'POST',
                url: '?handler=CheckLibraryName',
                data: { libraryname: name, libraryid: libraryid },
                headers: { 'RequestVerificationToken': antiToken() },
                success: function () {
                    if (seq !== _nameCheckSeq[feedbackId]) return;
                    input.classList.remove('is-invalid');
                    feedback.innerText = '';
                },
                error: function (xhr) {
                    if (seq !== _nameCheckSeq[feedbackId]) return;
                    if (xhr.status === 400) {
                        input.classList.add('is-invalid');
                        feedback.innerText = 'Name already exists';
                    }
                }
            });
        }

        // Create form — validate name and description before submit
        document.getElementById('createlibraryModal').addEventListener('submit', function (e) {
            var nameInput = document.getElementById('createlibraryname');
            var descInput = document.getElementById('createlibrarydescription');
            var name = nameInput.value.trim();
            var valid = true;
            if (!name) {
                nameInput.classList.add('is-invalid');
                document.getElementById('namefeedback').innerText = 'Field is required';
                valid = false;
            } else if (!/[a-zA-Z0-9]/.test(name)) {
                nameInput.classList.add('is-invalid');
                document.getElementById('namefeedback').innerText = 'Name must contain at least one letter or number';
                valid = false;
            }
            if (!descInput.value.trim()) {
                descInput.classList.add('is-invalid');
                valid = false;
            }
            if (!valid || nameInput.classList.contains('is-invalid')) {
                e.preventDefault();
            }
        });

        // Edit form — validate and submit via AJAX so the page stays on the Treatment Pool Libraries screen
        document.getElementById('editlibrary').addEventListener('submit', function (e) {
            e.preventDefault();
            var nameInput = document.getElementById('editlibraryname');
            var descInput = document.getElementById('editlibrarydescription');
            var libraryname = nameInput.value.trim();
            var librarydescription = descInput.value.trim();
            nameInput.value = libraryname;
            descInput.value = librarydescription;
            var valid = true;
            if (!libraryname) {
                nameInput.classList.add('is-invalid');
                document.getElementById('editnamefeedback').innerText = 'Field is required';
                valid = false;
            } else if (!/[a-zA-Z0-9]/.test(libraryname)) {
                nameInput.classList.add('is-invalid');
                document.getElementById('editnamefeedback').innerText = 'Name must contain at least one letter or number';
                valid = false;
            }
            if (!librarydescription) {
                descInput.classList.add('is-invalid');
                document.getElementById('editdescriptionfeedback').innerText = 'Field is required';
                valid = false;
            }
            if (!valid || nameInput.classList.contains('is-invalid')) return;

            var form = this;
            var token = antiToken();
            var submitBtn = form.querySelector('[type=submit]');
            submitBtn.disabled = true;

            $.ajax({
                type: 'POST',
                url: '?handler=CheckLibraryName',
                data: { libraryname: libraryname, libraryid: document.getElementById('editlibraryId').value },
                headers: { 'RequestVerificationToken': token },
                success: function () {
                    $.ajax({
                        type: 'POST',
                        url: '?handler=EditLibrary',
                        data: $(form).serialize(),
                        headers: { 'RequestVerificationToken': token },
                        success: function (res) {
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('EditLibraryForm')).hide();
                            submitBtn.disabled = false;
                            var message = (res && res.message) ? res.message : 'Treatment Pool Library updated successfully.';
                            showJobStatus('success', message);
                            var libraryId = document.getElementById('editlibraryId').value;
                            var isShared = document.getElementById('editisshared').checked;
                            var words = librarydescription.split(/\s+/).filter(Boolean);
                            var descShort = words.slice(0, 2).join(' ') + (words.length > 2 ? '...' : '');
                            var updatedFields = {
                                name: libraryname,
                                description: librarydescription,
                                descriptionShort: descShort,
                                shared: isShared ? 'Yes' : 'No',
                                isSharedValue: isShared
                            };
                            table.getRows().forEach(function (row) {
                                if (String(row.getData().poolId) === String(libraryId)) {
                                    row.update(updatedFields);
                                }
                            });
                            var row = tableData.find(function (x) { return String(x.poolId) === String(libraryId); });
                            if (row) {
                                Object.assign(row, updatedFields);
                            }
                        },
                        error: function (xhr) {
                            submitBtn.disabled = false;
                            var msg = xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'Unable to update. Please try again.';
                            alert(msg);
                        }
                    });
                },
                error: function () {
                    nameInput.classList.add('is-invalid');
                    document.getElementById('editnamefeedback').innerText = 'Name already exists';
                    submitBtn.disabled = false;
                }
            });
        });

        // ── Auto-filter / auto-open from query string (navigated from Scenarios page) ──
        (function () {
            var params   = new URLSearchParams(window.location.search);
            var search   = params.get('search');
            var importId = params.get('importId');
            var libId    = params.get('libId');

            if (libId) {
                // Exact library (navigated from a scenario): match by id, not a
                // "like" name search, so e.g. "Test20260620" doesn't also show
                // "Test20260620-Copy".
                var match = tableData.find(function (x) { return String(x.poolId).toLowerCase() === libId.toLowerCase(); });
                document.getElementById('searchInput').value = match ? match.name : (search || '');
                table.setFilter(function (data) { return String(data.poolId).toLowerCase() === libId.toLowerCase(); });
            } else if (search) {
                document.getElementById('searchInput').value = search;
                table.setFilter('name', 'like', search);
            }

            if (importId) {
                var lib = tableData.find(function (x) { return String(x.poolId).toLowerCase() === importId.toLowerCase(); });
                if (lib) {
                    setTimeout(function () { openImport(lib); }, 400);
                }
            }
        })();

        // ── Search (client-side) ──
        function applySearch() {
            var v = document.getElementById('searchInput').value.trim();
            var mine = document.getElementById('myLibraries').checked;
            table.clearFilter();
            var filters = [];
            if (v) {
                filters.push([
                    { field: 'name',         type: 'like', value: v },
                    { field: 'description',  type: 'like', value: v },
                    { field: 'scenarioName', type: 'like', value: v }
                ]);
            }
            if (mine) filters.push({ field: 'userId', type: '=',    value: currentUserId });
            if (filters.length) table.setFilter(filters);
            table.pbSaveFilters({ search: v, mine: mine });
        }

        // Restore the filter saved before navigating away — or before Create/Edit/Delete's
        // plain-form full navigation, or Copy/Import's reload once their background job
        // succeeds — all of which otherwise reset the search box and "My Treatment Pool
        // Libraries" checkbox back to blank.
        (function restoreLibraryFilterState() {
            var params = new URLSearchParams(window.location.search);
            // Don't clobber a filter the URL itself is directing (navigated from Scenarios page).
            if (params.get('search') || params.get('importId') || params.get('libId')) return;

            var saved = table.pbSavedFilters;
            if (!saved) return;

            document.getElementById('searchInput').value = saved.search || '';
            document.getElementById('myLibraries').checked = !!saved.mine;
            applySearch();
        })();

        document.getElementById('btnSearch').addEventListener('click', applySearch);
        document.getElementById('searchInput').addEventListener('keypress', function (e) { if (e.key === 'Enter') applySearch(); });
        document.getElementById('myLibraries').addEventListener('change', applySearch);
        document.getElementById('btnReset').addEventListener('click', function () {
            document.getElementById('searchInput').value = '';
            applySearch();
        });

        // ── Create new ──
        // Button only renders for users with Create permission — guard so its
        // absence doesn't throw and skip every handler registered after it
        // (same landmine fixed on the Scenarios page).
        var createLibraryBtn = document.getElementById('createnewlibrarybtn');
        if (createLibraryBtn) createLibraryBtn.addEventListener('click', function () {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('CreateNewLibraryForm')).show();
        });

        // ── Modal cleanup ──
        document.getElementById('CreateNewLibraryForm').addEventListener('hidden.bs.modal', function () {
            var form = document.getElementById('createlibraryModal');
            form.reset();
            form.classList.remove('was-validated');
            document.getElementById('createlibraryname').classList.remove('is-invalid');
            document.getElementById('createlibrarydescription').classList.remove('is-invalid');
        });

        document.getElementById('EditLibraryForm').addEventListener('hidden.bs.modal', function () {
            var form = document.getElementById('editlibrary');
            form.reset();
            form.classList.remove('was-validated');
            document.getElementById('editlibraryname').classList.remove('is-invalid');
            document.getElementById('editlibrarydescription').classList.remove('is-invalid');
        });

        // Offer the picked workbook's worksheet names as Tab Name choices.
        var _tabNameAutofill = pbTabNameAutofill.attach({
            fileInput: 'excelfile',
            tabInput: 'tabname',
            tabSelect: 'tabnameselect',
            onStatus: function (message) { document.getElementById('tabnamehint').textContent = message; }
        });

        document.getElementById('importtreatment').addEventListener('hidden.bs.modal', function () {
            document.getElementById('treatmentimportform').reset();
            _tabNameAutofill.reset();
            updateFromScratch();
        });

        document.getElementById('CopyLibraryForm').addEventListener('hidden.bs.modal', function () {
            var form = document.getElementById('copylibrary');
            form.reset();
            form.classList.remove('was-validated');
            document.getElementById('copylibraryname').classList.remove('is-invalid');
            document.getElementById('CopynNamefeedback').innerText = 'Field is required';
            document.getElementById('copylibrarydescription').classList.remove('is-invalid');
        });

        // ── Copy form AJAX submit ──
        document.getElementById('copylibrary').addEventListener('submit', function (e) {
            e.preventDefault();
            var nameInput = document.getElementById('copylibraryname');
            var descInput = document.getElementById('copylibrarydescription');
            var libraryname = nameInput.value.trim();
            var librarydescription = descInput.value.trim();
            nameInput.value = libraryname;
            descInput.value = librarydescription;
            if (!validateCopyLibraryName()) return;
            if (!validateLibraryDescription(descInput, 'copydescriptionfeedback')) return;
            if (!this.checkValidity()) { this.classList.add('was-validated'); return; }
            var form = this;
            var token = antiToken();
            var submitBtn = form.querySelector('[type=submit]');
            submitBtn.disabled = true;

            $.ajax({
                type: 'POST', url: '?handler=CheckLibraryName',
                data: { libraryname: libraryname, libraryid: '' },
                headers: { 'RequestVerificationToken': token },
                success: function () {
                    document.getElementById('CopynNamefeedback').innerText = '';
                    document.getElementById('copylibraryname').classList.remove('is-invalid');
                    $.ajax({
                        type: 'POST', url: '?handler=CreateSharedLibrary',
                        data: $(form).serialize(),
                        headers: { 'RequestVerificationToken': token },
                        success: function (res) {
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('CopyLibraryForm')).hide();
                            form.reset(); submitBtn.disabled = false;
                            var label = libraryname ? '"' + libraryname + '"' : 'Library';
                            sessionStorage.setItem('tplPendingJobId', res.jobId);
                            sessionStorage.setItem('tplPendingJobName', libraryname);
                            sessionStorage.setItem('tplPendingJobType', 'copy');
                            showJobStatus('running', label + ' copy running in the background…');
                            pollLibraryJob(res.jobId, libraryname, 'copy');
                        },
                        error: function (xhr) {
                            submitBtn.disabled = false;
                            var msg = xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'Unable to copy. Please try again.';
                            alert(msg);
                        }
                    });
                },
                error: function () {
                    document.getElementById('copylibraryname').classList.add('is-invalid');
                    document.getElementById('CopynNamefeedback').innerText = 'Name already exists';
                    submitBtn.disabled = false;
                }
            });
        });

        // ── fromScratch / keepAll sync ──
        function updateFromScratch() {
            var sel = document.querySelector('input[name="option"]:checked');
            if (!sel) return;
            var fs = document.getElementById('fromScratch'), ka = document.getElementById('keepAll');
            if (sel.value === 'deleteAll')      { fs.checked = true;  fs.value = true;  ka.value = false; ka.checked = false; }
            else if (sel.value === 'keepUserCreated') { fs.value = true;  fs.checked = true;  ka.value = true;  ka.checked = true; }
            else if (sel.value === 'keepAll')   { fs.value = false; fs.checked = false; ka.value = true;  ka.checked = true; }
        }
        document.addEventListener('change', function (e) { if (e.target.name === 'option') updateFromScratch(); });

        function showJobStatus(state, message) {
            var banner  = document.getElementById('jobStatusBanner');
            var spinner = document.getElementById('jobStatusSpinner');
            banner.className = 'run-status-banner run-status-' + state;
            document.getElementById('jobStatusMessage').textContent = message;
            spinner.style.display = (state === 'running') ? 'block' : 'none';
            banner.style.display = 'flex';
        }

        function hideJobStatus() {
            if (_tplPollTimer) { clearInterval(_tplPollTimer); _tplPollTimer = null; }
            document.getElementById('jobStatusBanner').style.display = 'none';
        }

        function checkfilesize() {
            var excelfile = document.getElementById('excelfile');
            var file = excelfile.files[0];
            var feedback = document.getElementById('excelvalidation');
            if (!file) return false;

            var fileSizeLimit = 128 * 1024 * 1024;
            var allowedExtensions = /\.(xls|xlsx)$/i;
            if (!allowedExtensions.test(file.name)) {
                excelfile.classList.add('is-invalid');
                feedback.textContent = 'Please upload a valid Excel file with .xls or .xlsx extension.';
                return false;
            }
            if (file.size > fileSizeLimit) {
                excelfile.classList.add('is-invalid');
                feedback.textContent = 'The excel file must be under 128Mb in size.';
                return false;
            }
            excelfile.classList.remove('is-invalid');
            return true;
        }

        function parseImportError(result) {
            if (!result) return 'Import failed. Please try again.';
            if (typeof result === 'string') return result;
            if (result.error) return result.error;
            if (Array.isArray(result)) return result.join('<br>');
            if (result.value && Array.isArray(result.value)) return result.value.join('<br>');
            return 'Import failed. Please try again.';
        }

        document.getElementById('treatmentimportform').addEventListener('submit', async function (event) {
            event.preventDefault();
            event.stopPropagation();
            updateFromScratch();

            var form = this;
            form.classList.remove('was-validated');
            document.getElementById('excelvalidation').textContent = 'Field is required';

            if (!form.checkValidity() || !checkfilesize()) {
                form.classList.add('was-validated');
                return;
            }

            var formData = new FormData(form);
            var submitBtn = form.querySelector('[type=submit]');
            var libraryName = _importLibraryName;
            var label = libraryName ? '"' + libraryName + '"' : 'Library';
            submitBtn.disabled = true;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('importtreatment')).hide();
            showOverlay();

            try {
                var response = await fetch(form.action, { method: 'POST', body: formData });
                var result = null;
                try { result = await response.json(); } catch (e) { /* non-json body */ }

                hideOverlay();

                if (response.ok && result && result.jobId) {
                    // Re-enable now (matching the Copy form's flow below) rather than
                    // leaving it disabled until the background job finishes: if that
                    // job later fails, pollLibraryJob has no reference to this button
                    // to re-enable it, so the next retry's Import button stayed
                    // disabled forever until a full page reload.
                    submitBtn.disabled = false;
                    sessionStorage.setItem('tplPendingJobId', result.jobId);
                    sessionStorage.setItem('tplPendingJobName', libraryName);
                    sessionStorage.setItem('tplPendingJobType', 'import');
                    showJobStatus('running', label + ' import running in the background…');
                    pollLibraryJob(result.jobId, libraryName, 'import');
                } else {
                    showJobStatus('error', parseImportError(result));
                    submitBtn.disabled = false;
                }
            } catch (error) {
                hideOverlay();
                showJobStatus('error', 'Unexpected error. Please try again.');
                submitBtn.disabled = false;
            }
        });

        // ── Background job polling (Copy & Import) ──
        var _tplPollTimer = null;

        function pollLibraryJob(jobId, libraryName, jobType) {
            if (_tplPollTimer) clearInterval(_tplPollTimer);
            var label  = libraryName ? '"' + libraryName + '"' : (jobType === 'copy' ? 'Library' : 'Import');
            var header = jobType === 'copy' ? 'Copy Library' : 'Import';
            _tplPollTimer = setInterval(function () {
                $.get('?handler=JobStatus', { jobId: jobId }, function (res) {
                    if (res.status === 'Succeeded') {
                        clearInterval(_tplPollTimer); _tplPollTimer = null;
                        sessionStorage.removeItem('tplPendingJobId');
                        sessionStorage.removeItem('tplPendingJobName');
                        sessionStorage.removeItem('tplPendingJobType');
                        var msg = jobType === 'copy'
                            ? label + ' copied successfully.'
                            : label + ' import completed successfully.';
                        sessionStorage.setItem('tplJobSuccess', msg);
                        location.reload();
                    } else if (res.status === 'Failed') {
                        clearInterval(_tplPollTimer); _tplPollTimer = null;
                        sessionStorage.removeItem('tplPendingJobId');
                        sessionStorage.removeItem('tplPendingJobName');
                        sessionStorage.removeItem('tplPendingJobType');
                        var errMsg = (jobType === 'copy' ? 'Copy failed: ' : 'Import failed: ') + (res.message || 'Unknown error');
                        showJobStatus('error', errMsg);
                    }
                    // Enqueued / Processing — keep polling
                });
            }, 3000);
        }

        // On every page load: resume polling if a job was running before a manual refresh,
        // or show a success banner stored just before the last auto-reload.
        (function () {
            var successMsg = sessionStorage.getItem('tplJobSuccess');
            if (successMsg) {
                sessionStorage.removeItem('tplJobSuccess');
                showJobStatus('success', successMsg);
                return;
            }
            var pendingJobId = sessionStorage.getItem('tplPendingJobId');
            if (pendingJobId) {
                var pendingName = sessionStorage.getItem('tplPendingJobName') || '';
                var pendingType = sessionStorage.getItem('tplPendingJobType') || 'copy';
                var label = pendingName ? '"' + pendingName + '"' : (pendingType === 'copy' ? 'Library' : 'Import');
                showJobStatus('running', label + ' is still running in the background…');
                pollLibraryJob(pendingJobId, pendingName, pendingType);
            }
        })();

        // ── Tour Guide (ported from the legacy /CandidatePools page tour) ──
        var tourCurStep = 0;
        var tourActiveSteps = [];
        var tourHighlightedAction = null;

        var tourAllSteps = [
            {
                requiresData: false,
                title: 'Create New Treatment Pool Library',
                text: 'Create a new treatment pool library here before importing or organizing treatments.',
                getTarget: function () { return document.getElementById('createnewlibrarybtn'); }
            },
            {
                requiresData: true,
                title: 'Library Actions',
                text: 'Open the actions menu to edit, copy or import.',
                getTarget: function () {
                    var rows = table.getRows();
                    return rows.length ? rows[0].getElement().querySelector('.btn-actions-toggle') : null;
                }
            },
            {
                requiresData: true,
                openActions: true,
                title: 'Open Treatments',
                text: 'Use Treatments to open the selected library and manage its treatment records.',
                getTarget: function () {
                    var rows = table.getRows();
                    if (!rows.length) return null;
                    var panel = rows[0].getElement().querySelector('.row-expand-panel');
                    return panel ? panel.querySelector('[data-action="Treatments"]') : null;
                }
            }
        ];

        function tourClosePanel() {
            table.getRows().forEach(function (r) {
                var p = r.getElement().querySelector('.row-expand-panel');
                if (p) p.style.display = 'none';
                var b = r.getElement().querySelector('.btn-actions-toggle');
                if (b) { b.classList.remove('open'); var ic = b.querySelector('i'); if (ic) { ic.className = 'fa-solid fa-chevron-down'; ic.style.fontSize = '10px'; } }
                r.normalizeHeight();
            });
        }

        function tourOpenPanel() {
            var rows = table.getRows(); if (!rows.length) return;
            var row = rows[0];
            var panel = row.getElement().querySelector('.row-expand-panel');
            if (panel) panel.style.display = 'block';
            var btn = row.getElement().querySelector('.btn-actions-toggle');
            if (btn) { btn.classList.add('open'); var ic = btn.querySelector('i'); if (ic) { ic.className = 'fa-solid fa-chevron-up'; ic.style.fontSize = '10px'; } }
            row.normalizeHeight();
        }

        function tourSetSpotlight(target) {
            var sp = document.getElementById('tour-spotlight');
            if (!target) {
                sp.style.left = '0'; sp.style.top = '0'; sp.style.width = '0'; sp.style.height = '0';
                sp.style.border = 'none'; sp.style.borderRadius = '0'; sp.style.display = 'block';
            } else {
                var r = target.getBoundingClientRect(), pad = 8;
                sp.style.left = (r.left - pad) + 'px';
                sp.style.top = (r.top - pad) + 'px';
                sp.style.width = (r.width + pad * 2) + 'px';
                sp.style.height = (r.height + pad * 2) + 'px';
                sp.style.border = '3px solid rgba(255,255,255,.85)';
                sp.style.borderRadius = '6px';
                sp.style.display = 'block';
            }
        }

        function tourPositionCard(target) {
            var card = document.getElementById('tour-card');
            var cardW = card.offsetWidth || 380;
            var cardH = card.offsetHeight || 220;
            var vw = window.innerWidth;
            var vh = window.innerHeight;
            var gap = 14;
            card.style.bottom = '';
            card.style.transform = 'none';
            if (!target) {
                card.style.left = '50%'; card.style.top = '50%';
                card.style.transform = 'translate(-50%,-50%)'; return;
            }
            var rect = target.getBoundingClientRect();
            var idealLeft = rect.left + rect.width / 2 - cardW / 2;
            card.style.left = Math.max(10, Math.min(idealLeft, vw - cardW - 10)) + 'px';
            var spaceBelow = vh - rect.bottom - 44 - gap;
            var spaceAbove = rect.top - 70 - gap;
            if (spaceBelow >= cardH) {
                card.style.top = (rect.bottom + gap) + 'px';
            } else if (spaceAbove >= cardH) {
                card.style.top = (rect.top - cardH - gap) + 'px';
            } else {
                card.style.left = '50%'; card.style.top = '50%';
                card.style.transform = 'translate(-50%,-50%)';
            }
        }

        function tourShowStep(idx) {
            if (tourHighlightedAction) { tourHighlightedAction.classList.remove('tour-action-highlight'); tourHighlightedAction = null; }
            tourClosePanel();
            var step = tourActiveSteps[idx], total = tourActiveSteps.length;
            document.getElementById('tour-badge').textContent = 'STEP ' + (idx + 1) + ' OF ' + total;
            document.getElementById('tour-title').textContent = step.title;
            document.getElementById('tour-text').textContent = step.text;
            document.getElementById('tour-next').textContent = idx === total - 1 ? 'Finish' : 'Next';
            document.getElementById('tour-prev').style.display = idx === 0 ? 'none' : '';
            if (step.openActions) tourOpenPanel();
            var target = step.getTarget ? step.getTarget() : null;
            if (step.openActions && target) { target.classList.add('tour-action-highlight'); tourHighlightedAction = target; }
            tourSetSpotlight(target);
            tourPositionCard(target);
        }

        function tourStart() {
            var hasData = table.getDataCount() > 0;
            tourActiveSteps = tourAllSteps.filter(function (s) { return !s.requiresData || hasData; });
            if (!tourActiveSteps.length) return;
            tourCurStep = 0;
            document.getElementById('tour-overlay').style.display = 'block';
            document.getElementById('tour-card').style.display = 'block';
            tourShowStep(0);
        }

        function tourEnd() {
            if (tourHighlightedAction) { tourHighlightedAction.classList.remove('tour-action-highlight'); tourHighlightedAction = null; }
            tourClosePanel();
            document.getElementById('tour-overlay').style.display = 'none';
            document.getElementById('tour-card').style.display = 'none';
            document.getElementById('tour-spotlight').style.display = 'none';
        }

        document.getElementById('btnGuide').addEventListener('click', tourStart);
        document.getElementById('tour-next').addEventListener('click', function () {
            if (tourCurStep >= tourActiveSteps.length - 1) { tourEnd(); return; }
            tourCurStep++; tourShowStep(tourCurStep);
        });
        document.getElementById('tour-prev').addEventListener('click', function () {
            if (tourCurStep <= 0) return;
            tourCurStep--; tourShowStep(tourCurStep);
        });
        document.getElementById('tour-skip').addEventListener('click', tourEnd);
        document.getElementById('tour-close').addEventListener('click', tourEnd);
        document.getElementById('tour-overlay').addEventListener('click', tourEnd);

        var tourKey = 'treatment-pool-libraries-page:v1';
        function tourMarkSeen() {
            fetch('?handler=MarkTourSeen&tourKey=' + encodeURIComponent(tourKey), {
                method: 'POST',
                headers: { 'RequestVerificationToken': antiToken() }
            }).catch(function () { });
        }
        var tourAutoStarted = false;
        var tourShouldAutoStart = false;
        function tourAutoStart() {
            if (tourAutoStarted || !tourShouldAutoStart) return;
            tourAutoStarted = true;
            tourMarkSeen();
            tourStart();
        }
        table.on('tableBuilt', function () { setTimeout(tourAutoStart, 300); });
        setTimeout(tourAutoStart, 1500);
        fetch('?handler=TourSeen&tourKey=' + encodeURIComponent(tourKey))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                tourShouldAutoStart = !(data && data.seen);
                tourAutoStart();
            })
            .catch(function () { });
    </script>
}
