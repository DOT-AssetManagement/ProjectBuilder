                @Html.AntiForgeryToken()
                <input type="hidden" name="libraryId" id="copylibraryId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Treatment Pool Library Name</label>
                        <input type="text" name="libraryname" id="copylibraryname" class="form-control" required
