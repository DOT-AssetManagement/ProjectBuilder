    },
    "ProjectBuilder.Domain.Tests": {
      "path": "test/ProjectBuilder.Domain.Tests/ProjectBuilder.Domain.Tests.abppkg",
      "folder": "test"
    },
    "ProjectBuilder.HttpApi.Client.ConsoleTestApp": {
      "path": "test/ProjectBuilder.HttpApi.Client.ConsoleTestApp/ProjectBuilder.HttpApi.Client.ConsoleTestApp.abppkg",
      "folder": "test"
    },
    "ProjectBuilder.DbMigrator": {
