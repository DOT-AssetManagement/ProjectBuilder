@page
@using System.Linq
@model ProjectBuilder.Web.Pages.SetUp.TreatmentTypes.IndexModel
@{
    ViewData["Title"] = "Treatment Types";
    Layout = "Shared/AdminLayout";
    ViewData["SubMenu"] = "TreatmentTypes";

    var rows = Model.TreatmentTypes.Select(t => new {
        id          = t.Id,
        assetType   = t.AssetType,
        moveEarlier = t.MoveEarlier,
        moveLater   = t.MoveLater
    }).ToList();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
}

<div class="editscen-content__header"><h1>Treatment Types</h1></div>

<div class="search-bar">
    <label>Search in Treatment Types</label>
    <div class="search-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="" />
    </div>
    <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
    <button class="btn-reset btn-sm" id="btnReset">Reset</button>
</div>

<div class="table-wrap">
    <div id="admin-table"></div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Edit Treatment Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" name="id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Treatment</label>
                        <input type="text" class="form-control" id="editIdDisplay" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Asset Type</label>
                        <input type="text" class="form-control" id="editAssetType" name="assetType" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Move Earlier Buffer</label>
                        <input type="number" class="form-control" id="editMoveEarlier" name="moveEarlier" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Move Later Buffer</label>
                        <input type="number" class="form-control" id="editMoveLater" name="moveLater" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script src="~/js/pbdss/table.js"></script>
    <script>
        var tableData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows));

        var table = createTable('#admin-table', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            actions: [
                {
                    label: 'Edit', icon: 'fa-solid fa-pen',
                    onClick: function (d) {
                        document.getElementById('editId').value = d.id;
                        document.getElementById('editIdDisplay').value = d.id;
                        document.getElementById('editAssetType').value = d.assetType || '';
                        document.getElementById('editMoveEarlier').value = d.moveEarlier !== null ? d.moveEarlier : '';
                        document.getElementById('editMoveLater').value = d.moveLater !== null ? d.moveLater : '';
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal')).show();
                    }
                }
            ],
            columns: [
                { title: 'Treatment',    field: 'id',          minWidth: 180, headerSort: false },
                { title: 'Asset Type',   field: 'assetType',   minWidth: 140, headerSort: false },
                { title: 'Move Earlier', field: 'moveEarlier', minWidth: 140, hozAlign: 'right', headerSort: false },
                { title: 'Move Later',   field: 'moveLater',   minWidth: 140, hozAlign: 'right', headerSort: false }
            ]
        });

        function applySearchFilter() {
            var v = document.getElementById('searchInput').value.trim().toLowerCase();
            table.clearFilter();
            if (v) table.setFilter(function (d) { return Object.values(d).some(function (x) { return String(x).toLowerCase().includes(v); }); });
            table.pbSaveFilters({ search: v });
        }
        document.getElementById('btnSearch').addEventListener('click', applySearchFilter);
        document.getElementById('searchInput').addEventListener('keypress', function (e) { if (e.key === 'Enter') document.getElementById('btnSearch').click(); });
        document.getElementById('btnReset').addEventListener('click', function () {
            document.getElementById('searchInput').value = '';
            table.clearFilter();
            table.pbSaveFilters({ search: '' });
        });

        // Restore a filter saved before navigating away, or before an edit post-back.
        (function restoreSearchFilter() {
            var saved = table.pbSavedFilters;
            if (saved && saved.search) {
                document.getElementById('searchInput').value = saved.search;
                applySearchFilter();
            }
        })();
    </script>
}
