@page
@model ProjectBuilder.Web.Pages.Pools.PoolScoreParametersModel
@using ProjectBuilder.Permissions
@using Volo.Abp.Authorization.Permissions
@inject IPermissionChecker PermissionChecker
@{
    Layout = "~/Pages/Shared/PBDSSLayout.cshtml";
    ViewData["PBVariant"] = "app";
    ViewData["PBActivePage"] = "supplementalcandidates";
    ViewData["Title"] = "Configuration";

    var canCreate = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Create);
    var canEdit = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Edit);
    var canDelete = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Delete);
    var canImport = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.ImportConfiguration);
    var canWorkCandidates = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Default);
    var canConfiguration = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Default);
    var canRun = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Run);

    var candidatesNav = new ProjectBuilder.Web.Pages.Shared.PoolCandidatesNavViewModel
    {
        PoolId = Model.PoolId,
        PoolName = Model.PoolName,
        ActiveMenu = "Configuration",
        CanWorkCandidates = canWorkCandidates,
        CanConfiguration = canConfiguration,
        CanRun = canRun
    };

    var tableData = new System.Collections.Generic.List<object>();
    foreach (var p in Model.PoolScoreParameters)
    {
        tableData.Add(new
        {
            PoolId      = p.PoolId,
            Measure     = p.Measure,
            Min         = p.Min,
            ScoreAtMin  = p.ScoreAtMin,
            Max         = p.Max,
            ScoreAtMax  = p.ScoreAtMax,
            Slope       = p.Slope.ToString("N2"),
            SafetyWeight   = p.SafetyWeight.ToString("N2"),
            MobilityWeight = p.MobilityWeight.ToString("N2"),
            EquityWeight   = p.EquityWeight.ToString("N2"),
            EnvWeight      = p.EnvWeight.ToString("N2"),
            CondWeight     = p.CondWeight.ToString("N2"),
            CreatedBy   = p.CreatedBy,
            CreatedAt   = p.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")
        });
    }
    var jsonTableData = System.Text.Json.JsonSerializer.Serialize(tableData);

    var isError = !string.IsNullOrWhiteSpace(Model.ErrorMessage);
    var hasMessage = isError || !string.IsNullOrWhiteSpace(Model.SuccessMessage);
    var messageText = isError ? Model.ErrorMessage : Model.SuccessMessage;
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pbdss/scenarioedit.css" />
    <style>
        body { overflow: hidden; }
        main {
            display: flex; flex-direction: row; margin-top: 0; padding: 0;
            width: 100%; overflow: hidden; background-color: rgb(248,248,248);
            height: calc(100vh - 70px - 44px);
        }
        .config-content {
            flex: 1; min-width: 0; padding: 20px 24px; overflow: hidden;
            height: 100%; display: flex; flex-direction: column;
        }
        #config-table { flex: 1; min-height: 0; }
    </style>
}

<partial name="_PoolCandidatesNav" model="candidatesNav" />

<div class="config-content">

    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible @(hasMessage ? "" : "d-none")" style="white-space:pre-line;" role="alert">
        @messageText
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <div class="search-bar">
        <label>Configuration</label>
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="" />
        </div>
        <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
        <button class="btn-reset btn-sm" id="btnReset">Reset</button>
        <div class="ms-auto-btns">
            @if (canCreate)
            {
                <button class="btn-new" id="btnCreate">Create New</button>
            }
            @if (canImport)
            {
                <button class="btn-new" id="btnImport" style="margin-left:8px;">Import</button>
                <a class="btn-new" style="margin-left:8px;" href="/templates/Configuration_Template.xlsx" download="Configuration_Template.xlsx">Download Template</a>
            }
            @if (canConfiguration)
            {
                <a class="btn-new" style="margin-left:8px;" href="?handler=Export&poolId=@Model.PoolId">Export</a>
            }
        </div>
    </div>

    <div class="table-wrap">
        <div id="config-table"></div>
    </div>

</div>

@* ── Edit / Create Modal ── *@
<div id="configModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="configModalTitle">Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="configForm" method="POST">
                <input type="hidden" name="input.PoolId" id="cfg-PoolId" value="@Model.PoolId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Measure</label>
                            <select class="form-select" id="cfg-Measure" required>
                                <option value="">Select Measure</option>
                            </select>
                            <input type="hidden" name="input.Measure" id="cfg-MeasureValue" />
                            <span id="measureExistsMsg" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Min</label>
                            <input type="text" class="form-control" name="input.Min" id="cfg-Min" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Score At Min</label>
                            <input type="text" class="form-control" name="input.ScoreAtMin" id="cfg-ScoreAtMin" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max</label>
                            <input type="text" class="form-control" name="input.Max" id="cfg-Max" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Score At Max</label>
                            <input type="text" class="form-control" name="input.ScoreAtMax" id="cfg-ScoreAtMax" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Slope</label>
                            <input type="text" class="form-control" name="input.Slope" id="cfg-Slope" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Safety Weight</label>
                            <input type="text" class="form-control" name="input.SafetyWeight" id="cfg-SafetyWeight" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mobility Weight</label>
                            <input type="text" class="form-control" name="input.MobilityWeight" id="cfg-MobilityWeight" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Equity Weight</label>
                            <input type="text" class="form-control" name="input.EquityWeight" id="cfg-EquityWeight" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Env. Weight</label>
                            <input type="text" class="form-control" name="input.EnvWeight" id="cfg-EnvWeight" oninput="validateDecimal(this)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cond. Weight</label>
                            <input type="text" class="form-control" name="input.CondWeight" id="cfg-CondWeight" oninput="validateDecimal(this)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="configSubmitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Delete Modal ── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill text-danger fa-2x me-3"></i>
                <span>Are you sure you want to delete this configuration?</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

@* ── Import Modal ── *@
<div class="modal fade" id="importModal" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="importForm" class="needs-validation" method="post" enctype="multipart/form-data" novalidate
                  asp-page-handler="ImportPoolScoreParameters">
                <div class="modal-body">
                    <input type="hidden" name="PoolId" value="@Model.PoolId" />
                    <div class="mb-3 d-none">
                        <label class="form-label">Import Mode</label><br />
                        <label><input type="radio" name="option" value="deleteAll" checked onchange="updateImportMode()"> Delete All</label> &nbsp;&nbsp;
                        <label><input type="radio" name="option" value="keepUserCreated" onchange="updateImportMode()"> Keep User Created</label> &nbsp;&nbsp;
                        <label><input type="radio" name="option" value="keepAll" onchange="updateImportMode()"> Keep All</label>
                    </div>
                    <input type="hidden" id="deleteAllHidden" name="deleteAll" value="true" />
                    <input type="hidden" id="keepAllHidden" name="keepAll" value="false" />
                    <input type="hidden" id="keepUserCreatedHidden" name="keepUserCreated" value="false" />
                    <div class="mb-3">
                        <label class="form-label">Excel File</label>
                        <input class="form-control" type="file" id="importFile" name="excelfile" required accept=".xlsx,.xls" />
                        <div id="fileValidation" class="invalid-feedback">File is required</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tab Name</label>
                        <input class="form-control" type="text" name="tabname" value="ScoreParameters" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    <script type="text/javascript" src="~/js/pbdss/table.js" asp-append-version="true"></script>
    <script>
        var tableData = @Html.Raw(jsonTableData);
        var poolId    = '@Model.PoolId';

        function validateDecimal(input) {
            input.value = input.value.replace(/[^0-9.\-]/g, '');
            input.value = input.value.replace(/(\..*)\./g, '$1');
        }

        function populateMeasureOptions(names) {
            var $sel = $('#cfg-Measure');
            $sel.empty().append(new Option('Select Measure', ''));
            (names || []).forEach(function (m) { $sel.append(new Option(m, m)); });
        }
        fetch('?handler=Measures')
            .then(function (r) { return r.json(); })
            .then(populateMeasureOptions)
            .catch(function (err) { console.error('Failed to load measures', err); });

        function populateModal(d) {
            $('#cfg-PoolId').val(d.PoolId);
            $('#cfg-Measure').val(d.Measure);
            $('#cfg-MeasureValue').val(d.Measure);
            $('#cfg-Min').val(d.Min);
            $('#cfg-ScoreAtMin').val(d.ScoreAtMin);
            $('#cfg-Max').val(d.Max);
            $('#cfg-ScoreAtMax').val(d.ScoreAtMax);
            $('#cfg-Slope').val(d.Slope);
            $('#cfg-SafetyWeight').val(d.SafetyWeight);
            $('#cfg-MobilityWeight').val(d.MobilityWeight);
            $('#cfg-EquityWeight').val(d.EquityWeight);
            $('#cfg-EnvWeight').val(d.EnvWeight);
            $('#cfg-CondWeight').val(d.CondWeight);
        }

        function clearModal() {
            $('#configForm')[0].reset();
            $('#cfg-PoolId').val(poolId);
            $('#measureExistsMsg').text('');
        }

        var currentDeleteMeasure = null;

        var table = createTable('#config-table', {
            data: tableData,
            maxHeightEl: '.table-wrap',
            paginationSize: 10,
            actions: [
                @if (canEdit) {
                <text>{
                    label: 'Edit', icon: 'fa-solid fa-pen',
                    onClick: function (d) {
                        $('#configModalTitle').text('Edit Configuration');
                        $('#cfg-Measure').prop('disabled', true);
                        populateModal(d);
                        $('#configForm').attr('action', '/Pools/PoolScoreParameters?handler=UpdatePoolScoreParameter');
                        $('#configSubmitBtn').text('Update');
                        $('#configModal').modal('show');
                    }
                },</text>
                }
                @if (canDelete) {
                <text>{
                    label: 'Delete', icon: 'fa-solid fa-trash', type: 'delete',
                    onClick: function (d) {
                        currentDeleteMeasure = d.Measure;
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal')).show();
                    }
                }</text>
                }
            ],
            columns: [
                { title: 'Measure',         field: 'Measure',        minWidth: 140 },
                { title: 'Min',             field: 'Min',            width: 80 },
                { title: 'Score At Min',    field: 'ScoreAtMin',     width: 110 },
                { title: 'Max',             field: 'Max',            width: 80 },
                { title: 'Score At Max',    field: 'ScoreAtMax',     width: 110 },
                { title: 'Slope',           field: 'Slope',          width: 90 },
                { title: 'Safety Wt.',      field: 'SafetyWeight',   width: 100 },
                { title: 'Mobility Wt.',    field: 'MobilityWeight', width: 110 },
                { title: 'Equity Wt.',      field: 'EquityWeight',   width: 100 },
                { title: 'Env. Wt.',        field: 'EnvWeight',      width: 90 },
                { title: 'Cond. Wt.',       field: 'CondWeight',     width: 90 },
                { title: 'Created By',      field: 'CreatedBy',      width: 130 },
                { title: 'Created At',      field: 'CreatedAt',      width: 160 }
            ]
        });

        // ── Search ──
        function applySearch() {
            var v = $('#searchInput').val().trim();
            table.clearFilter();
            if (v) table.setFilter('Measure', 'like', v);
            table.pbSaveFilters({ search: v });
        }
        $('#btnSearch').on('click', applySearch);
        $('#searchInput').on('keypress', function (e) { if (e.key === 'Enter') applySearch(); });
        $('#btnReset').on('click', function () {
            $('#searchInput').val('');
            table.clearFilter();
            table.pbSaveFilters({ search: '' });
        });

        // Restore a filter saved before navigating away, or before an edit/delete-triggered
        // reload.
        (function restoreSearchFilter() {
            var saved = table.pbSavedFilters;
            if (saved && saved.search) {
                $('#searchInput').val(saved.search);
                applySearch();
            }
        })();

        // ── Create ──
        $('#btnCreate').on('click', function () {
            clearModal();
            $('#configModalTitle').text('New Configuration');
            $('#cfg-Measure').prop('disabled', false);
            $('#configForm').attr('action', '/Pools/PoolScoreParameters?handler=CheckMeasureExists');
            $('#configSubmitBtn').text('Create');
            $('#configModal').modal('show');
        });

        // ── Delete confirm ──
        $('#confirmDeleteBtn').on('click', function () {
            if (!currentDeleteMeasure) return;
            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            $.ajax({
                type: 'GET',
                url: '?handler=DeletePoolScoreParameter&poolId=' + encodeURIComponent(poolId) + '&measure=' + encodeURIComponent(currentDeleteMeasure),
                success: function () { location.reload(); },
                error: function (xhr) { alert(xhr.responseText || 'Unable to delete.'); }
            });
        });

        // ── Import ──
        $('#btnImport').on('click', function () { $('#importModal').modal('show'); });

        // ── Form submit (create path checks measure, then creates) ──
        $('#configForm').on('submit', function (e) {
            var action = $(this).attr('action');
            if (action && action.indexOf('CheckMeasureExists') !== -1) {
                e.preventDefault();
                $('#measureExistsMsg').text('');
                $.post(action, $(this).serialize())
                    .done(function (resp) {
                        if (resp.exists) {
                            $('#measureExistsMsg').text('Measure already exists.');
                        } else {
                            $('#configForm').attr('action', '/Pools/PoolScoreParameters?handler=CreatePoolScoreParameter');
                            $('#configForm').off('submit').submit();
                        }
                    });
            }
        });

        $('#cfg-Measure').on('change', function () {
            $('#cfg-MeasureValue').val($(this).val());
            $('#measureExistsMsg').text('');
        });

        // ── Import mode radio ──
        function updateImportMode() {
            var val = $('input[name="option"]:checked').val();
            $('#deleteAllHidden').val(val === 'deleteAll' || val === 'keepUserCreated' ? 'true' : 'false');
            $('#keepAllHidden').val(val === 'keepAll' ? 'true' : 'false');
            $('#keepUserCreatedHidden').val(val === 'keepUserCreated' ? 'true' : 'false');
        }

        // ── Import file validation ──
        $('#importForm').on('submit', function (e) {
            var file = $('#importFile')[0].files[0];
            if (!file) {
                $('#fileValidation').addClass('d-block');
                $('#importFile').addClass('is-invalid');
                e.preventDefault();
            }
        });

        // ── Auto-open import if deep-linked ──
        $(document).ready(function () {
            if ('@Model.Import'.toLowerCase() === 'true') {
                $('#importModal').modal('show');
            }
        });
    </script>
    <partial name="_PoolCandidatesRunScript" />
}
