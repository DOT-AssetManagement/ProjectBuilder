@page
@using System.Linq
@using System.Text.Json
@using ProjectBuilder.Models.CandidatePool.Dtos
@using Volo.Abp.Authorization.Permissions
@using ProjectBuilder.Permissions
@model ProjectBuilder.Web.Pages.TreatmentPoolLibraries.IndexModel
@inject IPermissionChecker PermissionChecker
@{
    ViewData["Title"] = "Treatment Pool Libraries";
    ViewData["PBVariant"] = "app";
    ViewData["PBActivePage"] = "treatmentpoollibraries";
    Layout = "~/Pages/Shared/PBDSSLayout.cshtml";

    var canCreate = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Create);
    var canEdit = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Edit);
    var canDelete = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Delete);
    var canImport = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Import);
    var canCopy = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Copy);
    var canTreatments = await PermissionChecker.IsGrantedAsync(TreatmentPoolLibraryPermissions.Treatments.Default);
    var canEditAny = await PermissionChecker.IsGrantedAsync(AdministrationPermissions.Default);

    var libraryRows = (Model.Pools?.Libraries ?? Enumerable.Empty<CandidatePoolDto>())
        .Select(item => new
        {
            poolId    = item.Id,
            userId    = item.UserId,
            name      = item.Name ?? "",
            description      = item.Description ?? "",
            descriptionShort = string.Join(" ", (item.Description ?? "").Split(' ').Take(2))
                               + ((item.Description ?? "").Split(' ').Length > 2 ? "..." : ""),
            scenarioName      = item.SceName ?? "",
            treatmentsCount         = item.TreatmentsCount,
            pavementTreatmentsCount = item.PavementTreatmentsCount,
            bridgeTreatmentsCount   = item.BridgeTreatmentsCount,
            isImported    = item.PopulatedAt.HasValue ? "Yes" : "No",
            shared        = item.IsShared ? "Yes" : "No",
            isSharedValue = item.IsShared,
            owner         = item.Owner ?? "",
            ownerDisplay  = item.UserId != Model.CurrentUserId ? (item.Owner ?? "") : "",
            importDate    = item.FormattedPopulatedAt ?? "",
            createdAt     = item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("yyyy-MM-dd") : "",
            source        = item.Source ?? "",
            canEdit       = canEditAny || item.UserId == Model.CurrentUserId,
            isDeleteable  = item.IsDeleteable
        })
        .ToList();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
    <style>
        body { overflow: hidden; }
        main { display: flex; flex-direction: row; margin-top: 0; padding: 0; width: 100%; overflow: hidden; background-color: rgb(248,248,248); height: calc(100vh - 70px - 44px); }
        .tpl-sidebar { width: 60px; background: #c8d8e8; flex-shrink: 0; height: 100%; }
        .tpl-content { flex: 1; min-width: 0; padding: 20px 24px; overflow: hidden; height: 100%; display: flex; flex-direction: column; }
        .tpl-title-bar { flex-shrink: 0; background: #d87d2a; color: #fff; font-weight: 700; padding: 10px 24px; margin: -20px -24px 20px; }
        #table-tpl { flex: 1; min-height: 0; }

        #overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9999; justify-content: center; align-items: center; }
        .overlay-content { text-align: center; color: #fff; }
        .spinner { border: 6px solid rgba(255,255,255,.3); border-top: 6px solid #fff; border-radius: 50%; width: 50px; height: 50px; animation: spin .8s linear infinite; margin: 0 auto 10px; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* Job status notification banner */
        #jobStatusBanner { display: none; align-items: center; gap: 10px; padding: 10px 16px; margin-bottom: 10px; border-radius: 4px; font-size: 14px; }
        #jobStatusBanner.run-status-running { background: #fff3cd; border: 1px solid #ffc107; color: #856404; }
        #jobStatusBanner.run-status-success { background: #d4edda; border: 1px solid #28a745; color: #155724; }
        #jobStatusBanner.run-status-error   { background: #f8d7da; border: 1px solid #dc3545; color: #721c24; }
        .run-status-spinner { width: 16px; height: 16px; border: 3px solid rgba(0,0,0,.2); border-top-color: currentColor; border-radius: 50%; animation: spin .7s linear infinite; flex-shrink: 0; }
        .run-status-close { background: none; border: none; cursor: pointer; font-size: 18px; line-height: 1; padding: 0 4px; margin-left: auto; color: inherit; }
    </style>
}

<div class="tpl-sidebar"></div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showJobStatus('success', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? "")));
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showJobStatus('error', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString() ?? "")));
        });
    </script>
}

<div class="tpl-content">

    <div class="tpl-title-bar">Libraries</div>

    <div class="search-bar">
        <label>Search in Treatment Pool Libraries</label>
        <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="" />
        </div>
        <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
        <button class="btn-reset btn-sm" id="btnReset">Reset</button>
        <label class="my-scenarios-check">
            <input type="checkbox" id="myLibraries" /> My Treatment Pool Libraries
        </label>
