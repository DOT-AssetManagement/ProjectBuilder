@page
@model ProjectBuilder.Web.Pages.Pools.IndexModel
@using Volo.Abp.Authorization.Permissions
@using ProjectBuilder.Permissions
@inject IPermissionChecker PermissionChecker
@{
    Layout = "~/Pages/Shared/PBDSSLayout.cshtml";
    ViewData["PBVariant"] = "app";
    ViewData["PBActivePage"] = "supplementalcandidates";
    ViewData["Title"] = "Candidates +";

    var canCreate = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Create);
    var canEdit = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Edit);
    var canClear = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Clear);
    var canImportWork = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.ImportWorkCandidates);
    var canImportConfig = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.ImportConfiguration);
    var canWorkCandidates = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.WorkCandidates.Default);
    var canConfiguration = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Configuration.Default);
    var canRun = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Run);
    var canOutput = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.Map);
    var canExport = await PermissionChecker.IsGrantedAsync(SupplementalCandidatesPermissions.PoolsPageActions.ExportProjectsOrCandidate);

    var isAdmin = Model.IsAdmin;
    var currentUserId = Model.CurrentUserId;

    var tableData = new List<object>();
    if (Model.Pools != null)
    {
        foreach (var pool in Model.Pools)
        {
            tableData.Add(new
            {
                Id = pool.Id,
                UserId = pool.UserId,
                Name = pool.Name,
                Description = pool.Description,
                WorkCandidateCount = Model.WorkCandidateCounts.GetValueOrDefault(pool.Id),
                CreatedAt = pool.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss"),
                UpdatedAt = pool.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss"),
                IsActive = pool.IsActive,
                IsShared = pool.IsShared,
                ScenarioName = pool.SceName
            });
        }
    }
    var jsonTableData = System.Text.Json.JsonSerializer.Serialize(tableData);
    var hasPools = Model.Pools != null && Model.Pools.Any();
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables/dist/css/tabulator.min.css" rel="stylesheet">
    <style>
        main {
            display: flex;
            flex-direction: row;
            margin-top: 0;
            padding: 0;
            width: 100%;
            overflow: hidden;
            background-color: rgb(248,248,248);
            height: calc(100vh - 70px - 44px);
        }

        .pools-sidebar {
            width: 60px;
            background: #c8d8e8;
            flex-shrink: 0;
            height: 100%;
        }

        .pools-content {
            flex: 1;
            min-width: 0;
            padding: 20px 24px;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        #candidatepoolstable {
            flex: 1;
            min-height: 0;
        }

        .pools-banner {
            background: linear-gradient(90deg, #006699, #333333);
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 60px;
            text-align: center;
            color: #fff;
            font-weight: bold;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .errorMsg { color: red; }

        /* Run status notification banner */
        #runStatusBanner { display: none; align-items: center; gap: 10px; padding: 10px 16px; margin-bottom: 10px; border-radius: 4px; font-size: 14px; }
        #runStatusBanner.run-status-running { background: #fff3cd; border: 1px solid #ffc107; color: #856404; }
        #runStatusBanner.run-status-success { background: #d4edda; border: 1px solid #28a745; color: #155724; }
        #runStatusBanner.run-status-error   { background: #f8d7da; border: 1px solid #dc3545; color: #721c24; }
        .run-status-spinner { width: 16px; height: 16px; border: 3px solid rgba(0,0,0,.2); border-top-color: currentColor; border-radius: 50%; animation: spin .7s linear infinite; flex-shrink: 0; }
        .run-status-close { background: none; border: none; cursor: pointer; font-size: 18px; line-height: 1; padding: 0 4px; margin-left: auto; color: inherit; }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}

<div class="pools-sidebar"></div>

<div class="pools-content">

        @if (!hasPools)
        {
            <div class="pools-banner">Create new candidate + to begin</div>
        }

        <div id="runStatusBanner" role="alert">
            <span class="run-status-spinner" id="runStatusSpinner"></span>
            <span id="runStatusMessage"></span>
            <button class="run-status-close" onclick="hideRunStatus()" title="Dismiss">&times;</button>
        </div>

        <form id="antiforgery-form" method="post" style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <div class="search-bar">
            <label>Search in Candidates +</label>
            <div class="search-input-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="" value="@Model.SearchString" />
            </div>
            <button class="btn btn-primary btn-sm" id="btnSearch">Search</button>
            <button class="btn-reset btn-sm" id="btnReset">Reset</button>
            <label class="my-scenarios-check">
                <input type="checkbox" id="myPools" checked /> My Candidates +
            </label>
            @if (isAdmin)
            {
            <label class="my-scenarios-check">
                <input type="checkbox" id="otherPools" checked /> Other Candidates +
            </label>
            }
            <div class="ms-auto-btns">
                @if (canCreate)
                {
                <button class="btn-new" id="btnCreatePool">Create New Candidate +</button>
                }
            </div>
        </div>

        <div class="table-wrap">
            <div id="candidatepoolstable"></div>
        </div>

</div>

@* ── Create Candidate + Pool ── *@
<div class="modal fade" id="CreateLibraryForm" tabindex="-1" role="dialog" aria-labelledby="createlibraryheader" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createlibraryheader">Create Candidate +</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createLibraryForm1" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Name" class="form-label">Candidate + Name</label>
                        <input type="text" name="Name" class="form-control" maxlength="50" required />
                        <div><span class="errorMsg nameError"></span></div>
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Candidate + Description</label>
                        <input name="Description" type="text" class="form-control" required />
                    </div>
                    <div class="form-check mb-3 d-none">
                        <input class="form-check-input" type="radio" name="IsActive" value="true" checked>
                        <label class="form-check-label" for="IsActive">Create an empty candidate +</label>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="IsSharedLibrary" name="IsSharedLibrary" value="true">
                            <label class="form-check-label" for="IsSharedLibrary">Shared</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Edit Candidate + Pool ── *@
<div class="modal fade" id="EditLibraryForm" tabindex="-1" role="dialog" aria-labelledby="editlibraryheader" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editlibraryheader">Edit Candidate +</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editlibrary" class="needs-validation" method="post" asp-page-handler="UpdatePool" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="poolId" name="input.Id">
                    <div class="mb-3">
                        <label for="editlibraryname" class="form-label">Candidate + Name</label>
                        <input type="text" id="editlibraryname" name="input.Name" class="pool-name form-control" maxlength="50" required />
                        <div id="editnamefeedback" class="invalid-feedback">Field is required</div>
                        <div><span class="errorMsg nameError"></span></div>
                    </div>
                    <div class="mb-3">
                        <label for="editlibrarydescription" class="form-label">Candidate + Description</label>
                        <input type="text" id="editlibrarydescription" name="input.Description" class="pool-description form-control" required />
                        <div id="editdescriptionfeedback" class="invalid-feedback">Field is required</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="input.IsSharedLibrary" id="isshared" value="true">
                            <label class="form-check-label" for="isshared">Shared</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Import ── *@
<div class="modal fade" id="importcandiates" tabindex="-1" role="dialog" aria-labelledby="importtreatmentlabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="treatmentimportform" class="needs-validation" method="post" enctype="multipart/form-data" novalidate asp-page-handler="ImportWorkCandidates">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="libraries" class="form-label">Candidate +</label>
                        <input class="form-control" type="text" name="candidatepool_name" id="candidatepool_name" readonly>
                        <input class="form-control" type="hidden" name="PoolId" id="candidatepoolid">
                    </div>
                    <div class="mb-3">
                        <label>
                            <input type="radio" name="option" value="deleteAll" checked onchange="updateFromScratch()"> Delete All
                            <input type="checkbox" id="fromScratch" name="fromScratch" checked value="true" hidden />
                        </label> &nbsp;&nbsp;
                        <label>
                            <input type="radio" name="option" value="keepUserCreated" onchange="updateFromScratch()"> Keep User Created
                        </label> &nbsp;&nbsp;
                        <label>
                            <input type="radio" name="option" value="keepAll" onchange="updateFromScratch()"> Keep All
                            <input type="checkbox" id="keepAll" name="keepAll" value="false" hidden />
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="formFile" class="form-label">Excel File</label>
                        <input class="form-control" type="file" id="excelfile" name="excelfile" accept=".xlsx,.xls">
                        <div id="excelvalidation" class="invalid-feedback">Field is required</div>
                        <div id="fileSizeError" class="invalid-feedback d-none">the excel file must be under 128Mb in size</div>
                    </div>
                    <div class="mb-3 d-none">
                        <label for="formFile" class="form-label">Tab Name</label>
                        <input class="form-control" type="text" name="tabname" value="WorkCandidates">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Import</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

