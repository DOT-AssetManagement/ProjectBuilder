            <div class="modal-body d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill text-danger fa-2x me-3"></i>
                <span id="deletePoolConfirmMsg">Are you sure you want to delete this candidate +?</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeletePoolBtn" class="btn btn-danger">Delete</button>
            </div>
